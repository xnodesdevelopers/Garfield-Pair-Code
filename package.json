{
  "name": "garfield-pair-device",
  "version": "1.0.0",
  "description": "Garfield WhatsApp QR & session device",
  "main": "./module.js",
  "type": "module",
  "engines": { 
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "pm2 start module.js --deep-monitoring --attach --name garfield-session",
    "stop": "pm2 stop garfield-session",
    "restart": "pm2 restart garfield-session"
  },
