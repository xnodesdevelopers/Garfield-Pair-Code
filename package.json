  "license": "GPL-3.0",
  "dependencies": {
    "@whiskeysockets/baileys": "latest",
    "qrcode": "latest",
    "awesome-phonenumber": "latest",
    "megajs": "latest",
    "pino": "latest",
    "body-parser": "latest",
    "express": "latest",
    "phone": "latest",
    "pm2": "latest"
  }
}

